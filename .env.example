# Blizzard Developer Portal credentials
# Register a client at https://develop.battle.net
#
# LOCAL RUNS: copy your values into a real .env file at the project root.
# .env is gitignored.
#
# CI RUNS: don't put secrets here — set them as GitHub repo secrets instead:
#   gh secret set BLIZZARD_CLIENT_ID --repo gitgipie/metagor
#   gh secret set BLIZZARD_CLIENT_SECRET --repo gitgipie/metagor
# The scraper reads .env when present and falls back to BLIZZARD_* env vars
# when it isn't, so both paths work with the same code.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
